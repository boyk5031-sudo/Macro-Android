      "macroId": "6f1d3a2e-2c7b-4a4e-9a55-2f0c1f4f5a10",
      "enabled": true, "zoneId": "Asia/Kolkata",
      "kind": { "type": "daily", "localTime": "07:30", "daysOfWeek": ["MONDAY","TUESDAY","WEDNESDAY","THURSDAY","FRIDAY"] },
      "requiresBatteryNotLow": true, "missedRunPolicy": "RUN_LATE", "lateThreshold": "PT30M" }
  ]
